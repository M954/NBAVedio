# Azure OpenAI（脚本生成所需）
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Azure Speech TTS（推荐：作为 edge-tts 之前的首选语音后端，避开 Bing WebSocket 403）
# 在 Azure Portal -> Speech 资源 中获取 key 与 region（如 eastasia / eastus）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 网络代理（edge-tts 走 wss://speech.platform.bing.com 时通常需要）
HTTPS_PROXY=
